# Server-side only — used inside Netlify Functions, never exposed to the browser.
# Set the real values in Netlify: Site settings → Environment variables.

# Secret used to sign session tokens for custom auth
AUTH_JWT_SECRET=replace-with-a-long-random-string

# One-time bootstrap admin account, created on first function cold-start if no accounts exist yet
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-me-before-first-deploy
